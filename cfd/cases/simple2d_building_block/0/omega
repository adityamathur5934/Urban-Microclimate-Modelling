FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

// Specific dissipation rate at zref=10m: omega ~ 0.313 s-1
internalField   uniform 0.313;

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletOmega;
        Uref            5.0;
        Zref            10.0;
        z0              uniform 0.05;
        d               uniform 0.0;
        value           uniform 0.313;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.313;
        value           uniform 0.313;
    }

    ground
    {
        type            omegaWallFunction;
        value           uniform 0.313;
    }

    building
    {
        type            omegaWallFunction;
        value           uniform 0.313;
    }

    top
    {
        type            slip;
    }

    frontAndBack
    {
        type            empty;
    }
}

