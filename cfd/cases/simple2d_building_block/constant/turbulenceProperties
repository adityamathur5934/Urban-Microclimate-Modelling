FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  RAS;

RAS
{
    // Menter Shear Stress Transport (k-omega SST) RANS model
    // Selected for superior bluff-body separation and adverse pressure gradient handling
    RASModel        kOmegaSST;

    turbulence      on;

    printCoeffs     on;
}

